LAB_DATA_DIR=./data
LAB_OLLAMA_URL=http://127.0.0.1:11434
# Intentionally empty. Choose already-installed local model names later.
LAB_CHAT_MODEL=
LAB_EMBED_MODEL=
LAB_QDRANT_URL=http://127.0.0.1:6333
LAB_POSTGRES_DSN=postgresql://lab:local-lab-only@127.0.0.1:5434/lab
LAB_REQUEST_TIMEOUT=120
LAB_API_URL=http://127.0.0.1:8020

# OpenAI-compatible inference API: fill in later. No connection is made at startup.
# Use the API base URL, usually ending in /v1, not /chat/completions.
# Example formats: https://your-provider.example/v1 or http://127.0.0.1:1234/v1
LAB_OPENAI_BASE_URL=
LAB_OPENAI_API_KEY=
LAB_OPENAI_CHAT_MODEL=
LAB_OPENAI_EMBED_MODEL=
# Optional revision label: change it and rebuild indexes if the embedding model changes.
LAB_OPENAI_EMBED_REVISION=
# For providers that require the older field, change this to max_tokens.
LAB_OPENAI_TOKEN_PARAMETER=max_completion_tokens
# Leave false for models/providers that do not accept a temperature parameter.
LAB_OPENAI_SEND_TEMPERATURE=false
# Set false if the provider does not support streamed token-usage statistics.
LAB_OPENAI_STREAM_USAGE=true
