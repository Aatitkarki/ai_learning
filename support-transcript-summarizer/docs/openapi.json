{
  "openapi": "3.1.0",
  "info": {
    "title": "Support Transcript Summarizer",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/summaries": {
      "post": {
        "summary": "Summarize",
        "operationId": "summarize_api_summaries_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "History",
        "operationId": "history_api_summaries_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryItem"
                  },
                  "title": "Response History Api Summaries Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/summaries/upload": {
      "post": {
        "summary": "Summarize Upload",
        "operationId": "summarize_upload_api_summaries_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_summarize_upload_api_summaries_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/summaries/{record_id}": {
      "get": {
        "summary": "Get Summary",
        "operationId": "get_summary_api_summaries__record_id__get",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Draft",
        "operationId": "update_draft_api_summaries__record_id__patch",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Summary",
        "operationId": "delete_summary_api_summaries__record_id__delete",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/summaries/{record_id}/export": {
      "get": {
        "summary": "Export",
        "operationId": "export_api_summaries__record_id__export_get",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_summarize_upload_api_summaries_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "title": "Title",
            "default": "Uploaded conversation"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_summarize_upload_api_summaries_upload_post"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text"
          },
          "source_lines": {
            "items": {
              "type": "integer",
              "maximum": 80.0,
              "minimum": 1.0
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Source Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "source_lines"
        ],
        "title": "Claim"
      },
      "DraftUpdate": {
        "properties": {
          "draft_markdown": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Draft Markdown"
          },
          "revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "draft_markdown",
          "revision"
        ],
        "title": "DraftUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Handover": {
        "properties": {
          "customer_issue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "customer_name": {
            "$ref": "#/components/schemas/SourcedValue"
          },
          "amount": {
            "$ref": "#/components/schemas/SourcedValue"
          },
          "transfer_reference": {
            "$ref": "#/components/schemas/SourcedValue"
          },
          "stated_date": {
            "$ref": "#/components/schemas/SourcedValue"
          },
          "delay_reason": {
            "$ref": "#/components/schemas/SourcedValue"
          },
          "key_facts": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Key Facts"
          },
          "actions_taken": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Actions Taken"
          },
          "unresolved_questions": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 6,
            "title": "Unresolved Questions"
          },
          "contradictions": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Contradictions"
          },
          "suggested_next_steps": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 6,
            "title": "Suggested Next Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_issue",
          "customer_name",
          "amount",
          "transfer_reference",
          "stated_date",
          "delay_reason",
          "key_facts",
          "actions_taken",
          "unresolved_questions",
          "contradictions",
          "suggested_next_steps"
        ],
        "title": "Handover"
      },
      "HistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "is_edited": {
            "type": "boolean",
            "title": "Is Edited"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at",
          "is_edited"
        ],
        "title": "HistoryItem"
      },
      "Metrics": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "ollama"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "latency_ms",
          "input_tokens",
          "output_tokens",
          "prompt_version"
        ],
        "title": "Metrics"
      },
      "SavedSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "summary": {
            "$ref": "#/components/schemas/Handover"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "draft_markdown": {
            "type": "string",
            "title": "Draft Markdown"
          },
          "is_edited": {
            "type": "boolean",
            "title": "Is Edited"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "transcript",
          "summary",
          "metrics",
          "draft_markdown",
          "is_edited",
          "revision",
          "created_at",
          "updated_at"
        ],
        "title": "SavedSummary"
      },
      "SourcedValue": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "source_lines": {
            "items": {
              "type": "integer",
              "maximum": 80.0,
              "minimum": 1.0
            },
            "type": "array",
            "maxItems": 8,
            "title": "Source Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "source_lines"
        ],
        "title": "SourcedValue"
      },
      "SummaryRequest": {
        "properties": {
          "transcript": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Transcript"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "default": "Support conversation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript"
        ],
        "title": "SummaryRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
